  "relationships": [
    {"from": "gross_profit", "to": "revenue", "type": "derived_from", "formula": "revenue - cost_of_revenue", "description": "毛利 = 营业收入 - 营业成本"},
    {"from": "ebit", "to": "profit_before_tax", "type": "derived_from", "formula": "profit_before_tax + interest_expense", "description": "息税前利润 = 利润总额 + 利息费用"},
    {"from": "net_profit", "to": "profit_before_tax", "type": "derived_from", "formula": "profit_before_tax - income_tax", "description": "净利润 = 利润总额 - 所得税费用"},
    {"from": "free_cash_flow", "to": "operating_cash_flow", "type": "derived_from", "formula": "operating_cash_flow - capex", "description": "自由现金流 = 经营现金流净额 - 资本性支出"},
    {"from": "roe", "to": "net_profit_parent", "type": "derived_from", "formula": "net_profit_parent / avg(equity_parent)", "description": "ROE = 归母净利润 / 平均归母权益"},
    {"from": "debt_ratio", "to": "total_liabilities", "type": "derived_from", "formula": "total_liabilities / total_assets", "description": "资产负债率 = 负债合计 / 资产总计"},
    {"from": "current_ratio", "to": "current_assets", "type": "derived_from", "formula": "current_assets / current_liabilities", "description": "流动比率 = 流动资产合计 / 流动负债合计"},
    {"from": "interest_coverage", "to": "ebit", "type": "derived_from", "formula": "ebit / interest_expense", "description": "利息保障倍数 = EBIT / 利息费用"},
    {"from": "period_expense_ratio", "to": "selling_expenses", "type": "derived_from", "formula": "(selling + admin + rd + finance) / revenue", "description": "期间费用率 = 四费合计 / 营业收入"}
  ]
}
